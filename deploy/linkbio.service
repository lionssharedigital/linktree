[Unit]
Description=link-in-bio (Node.js)
After=network.target

[Service]
Type=simple
User=linkbio
WorkingDirectory=/opt/linkbio
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=2
EnvironmentFile=/opt/linkbio/.env

# Light sandboxing — the app only needs to read its own directory and
# bind to localhost:3000 (fronted by Caddy/nginx for TLS).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/linkbio

[Install]
WantedBy=multi-user.target
