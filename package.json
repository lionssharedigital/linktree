{
  "name": "gravitas-links",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-artist link-in-bio pages on Cloudflare Workers (D1 + R2), with per-artist logins and first-party click tracking.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply gravitaslink --remote",
    "db:migrate:local": "wrangler d1 migrations apply gravitaslink --local",
    "admin-invite": "node scripts/admin-invite.mjs",
    "import-legacy": "node scripts/import-legacy.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.143.0"
  }
}
