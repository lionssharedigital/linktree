# Copy this file to .env and fill in real values. Never commit .env.

# Port the Node process listens on (put Caddy/nginx in front of it)
PORT=3000

# Public URL of the site (used for canonical link + absolute og:image URL)
SITE_URL=https://links.example.com

# Basic-auth credentials that protect /stats
STATS_USER=admin
STATS_PASS=change-me-to-something-long-and-random

# Basic-auth credentials that protect /admin (the editor UI). Defaults to
# STATS_USER/STATS_PASS if left unset — set these separately if your
# marketing editor should be able to edit content but not see analytics.
ADMIN_USER=admin
ADMIN_PASS=change-me-too-and-make-it-different
